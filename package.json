{
  "name": "ajankati",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "pnpm build && electron apps/desktop/dist/main.cjs",
    "start": "electron apps/desktop/dist/main.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "pnpm build && vitest run tests/worker.test.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "demo": "tsx scripts/demo.ts",
    "test:desktop": "tsx scripts/desktop-smoke.ts",
    "format:check": "prettier --check apps packages scripts tests package.json tsconfig.json eslint.config.js pnpm-workspace.yaml"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.4.0",
    "jsdom": "27.4.0",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
